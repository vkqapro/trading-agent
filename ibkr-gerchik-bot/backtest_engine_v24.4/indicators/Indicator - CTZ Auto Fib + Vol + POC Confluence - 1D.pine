//@version=6
//
// ─────────────────────────────────────────────────────────────────────────────
//  CTZ Auto Fib  +  Volume at Level  +  POC / VAH / VAL Confluence
// ─────────────────────────────────────────────────────────────────────────────
//
//  Automatically detects the most recent swing high and swing low,
//  draws Fibonacci retracement levels, shows volume traded at each level,
//  and calculates an internal Volume Profile (POC, VAH, VAL) over the
//  swing range — flagging any fib level that confluences with these zones.
//
//  TradingView does not allow scripts to read values from other indicators,
//  so the Volume Profile is calculated internally from raw price/volume data.
//
// ─────────────────────────────────────────────────────────────────────────────

indicator("CTZ Auto Fib + Vol + POC Confluence", "Auto Fib Pro", overlay = true, max_lines_count = 30, max_labels_count = 30)


// ─────────────────────────────────────────────────────────────────────────────
//  INPUTS
// ─────────────────────────────────────────────────────────────────────────────

i_swingLen      = input.int   (10,      "Swing Detection Length",   minval = 2,  maxval = 50,    group = "Swing Detection")
i_source        = input.string("Wicks", "Price Source",             options = ["Wicks","Close"],  group = "Swing Detection")

i_show_0        = input.bool  (true,    "0%",       group = "Fib Levels")
i_show_236      = input.bool  (true,    "23.6%",    group = "Fib Levels")
i_show_382      = input.bool  (true,    "38.2%",    group = "Fib Levels")
i_show_500      = input.bool  (true,    "50%",      group = "Fib Levels")
i_show_618      = input.bool  (true,    "61.8%",    group = "Fib Levels")
i_show_705      = input.bool  (false,   "70.5%",    group = "Fib Levels")
i_show_786      = input.bool  (true,    "78.6%",    group = "Fib Levels")
i_show_100      = input.bool  (true,    "100%",     group = "Fib Levels")
i_show_1272     = input.bool  (false,   "127.2% (extension)", group = "Fib Levels")
i_show_1618     = input.bool  (false,   "161.8% (extension)", group = "Fib Levels")

i_lineWidth     = input.int   (1,       "Line Width",    minval = 1, maxval = 4,   group = "Style")
i_lineStyle     = input.string("Dashed","Line Style",    options = ["Solid","Dashed","Dotted"], group = "Style")
i_labelSize     = input.string("Small", "Label Size",    options = ["Tiny","Small","Normal"],   group = "Style")
i_showPrice     = input.bool  (true,    "Show price on label",      group = "Style")
i_extendLines   = input.bool  (true,    "Extend lines right",       group = "Style")

i_volBandPct    = input.float (0.5,     "Volume band width (%)",
                               minval = 0.1, maxval = 5.0, step = 0.1,
                               tooltip = "Price band as % of fib range used to accumulate volume at each level.",
                               group = "Volume at Level")
i_volLookback   = input.int   (500,     "Volume lookback (bars)",
                               minval = 50, maxval = 5000,
                               group = "Volume at Level")
i_showVol       = input.bool  (true,    "Show volume on label",     group = "Volume at Level")
i_volStrength   = input.bool  (true,    "Show HIGH / MED / LOW",    group = "Volume at Level")

i_profBins      = input.int   (50,      "Profile bins (resolution)",
                               minval = 10, maxval = 200,
                               tooltip = "Number of price buckets for the internal volume profile. Higher = more precise POC.",
                               group = "Volume Profile (POC / VAH / VAL)")
i_vaPercent     = input.float (70.0,    "Value Area %",
                               minval = 50.0, maxval = 95.0, step = 1.0,
                               tooltip = "Percentage of total volume that defines the Value Area. Standard is 70%.",
                               group = "Volume Profile (POC / VAH / VAL)")
i_confluencePct = input.float (0.5,     "Confluence tolerance (%)",
                               minval = 0.1, maxval = 3.0, step = 0.1,
                               tooltip = "How close a fib level must be to POC/VAH/VAL (as % of fib range) to be flagged as confluence.",
                               group = "Volume Profile (POC / VAH / VAL)")
i_showPOCLine   = input.bool  (true,    "Draw POC line on chart",   group = "Volume Profile (POC / VAH / VAL)")
i_showVALines   = input.bool  (true,    "Draw VAH / VAL lines",     group = "Volume Profile (POC / VAH / VAL)")
i_showPOCLabel  = input.bool  (true,    "Show POC / VAH / VAL labels", group = "Volume Profile (POC / VAH / VAL)")

i_c_0           = input.color (#787B86, "0% / 100%",   group = "Colors")
i_c_236         = input.color (#F7525F, "23.6%",       group = "Colors")
i_c_382         = input.color (#FF9800, "38.2%",       group = "Colors")
i_c_500         = input.color (#4CAF50, "50%",         group = "Colors")
i_c_618         = input.color (#2196F3, "61.8%",       group = "Colors")
i_c_705         = input.color (#9C27B0, "70.5%",       group = "Colors")
i_c_786         = input.color (#E040FB, "78.6%",       group = "Colors")
i_c_ext         = input.color (#787B86, "Extensions",  group = "Colors")
i_c_poc         = input.color (#FFD700, "POC line",    group = "Colors")
i_c_va          = input.color (#B0BEC5, "VAH / VAL lines", group = "Colors")
i_c_confluence  = input.color (#FFD700, "Confluence highlight", group = "Colors")


// ─────────────────────────────────────────────────────────────────────────────
//  HELPERS
// ─────────────────────────────────────────────────────────────────────────────

f_showLevel(int idx) =>
    switch idx
        0 => i_show_0
        1 => i_show_236
        2 => i_show_382
        3 => i_show_500
        4 => i_show_618
        5 => i_show_705
        6 => i_show_786
        7 => i_show_100
        8 => i_show_1272
        9 => i_show_1618
        => false

f_levelColor(int idx) =>
    switch idx
        0 => i_c_0
        1 => i_c_236
        2 => i_c_382
        3 => i_c_500
        4 => i_c_618
        5 => i_c_705
        6 => i_c_786
        7 => i_c_0
        8 => i_c_ext
        9 => i_c_ext
        => i_c_0

f_lineStyle() =>
    i_lineStyle == "Dashed" ? line.style_dashed :
     i_lineStyle == "Dotted" ? line.style_dotted :
     line.style_solid

f_labelSize() =>
    i_labelSize == "Tiny"   ? size.tiny   :
     i_labelSize == "Normal" ? size.normal :
     size.small

f_fmtVol(float v) =>
    v >= 1000000000 ? str.tostring(math.round(v / 1000000000, 2)) + "B" :
     v >= 1000000    ? str.tostring(math.round(v / 1000000,    2)) + "M" :
     v >= 1000        ? str.tostring(math.round(v / 1000,       1)) + "K" :
     str.tostring(math.round(v, 0))


// ─────────────────────────────────────────────────────────────────────────────
//  SWING DETECTION
// ─────────────────────────────────────────────────────────────────────────────

float hiSrc = i_source == "Wicks" ? high : close
float loSrc = i_source == "Wicks" ? low  : close

float swingHigh = ta.pivothigh(hiSrc, i_swingLen, i_swingLen)
float swingLow  = ta.pivotlow (loSrc, i_swingLen, i_swingLen)

var float lastSwingHighPrice = na
var int   lastSwingHighBar   = na
var float lastSwingLowPrice  = na
var int   lastSwingLowBar    = na

if not na(swingHigh)
    lastSwingHighPrice := swingHigh
    lastSwingHighBar   := bar_index - i_swingLen

if not na(swingLow)
    lastSwingLowPrice := swingLow
    lastSwingLowBar   := bar_index - i_swingLen


// ─────────────────────────────────────────────────────────────────────────────
//  VOLUME PROFILE  —  POC / VAH / VAL over the swing range
// ─────────────────────────────────────────────────────────────────────────────

// Builds a histogram of volume across price bins spanning the full swing range.
// Returns [pocPrice, vahPrice, valPrice]
f_buildProfile(float rangeHi, float rangeLo, float rangeSize, int bins, float vaPercent, int lookback) =>

    float binSize   = rangeSize / bins
    float[] binVol  = array.new_float(bins, 0.0)

    // Distribute each bar's volume into the bins it overlaps
    for i = 0 to lookback - 1
        float barHi = high[i]
        float barLo = low[i]
        float barVol = volume[i]

        // Skip bars entirely outside the range
        if barHi < rangeLo or barLo > rangeHi
            continue

        // Clamp bar to range
        float clampHi = math.min(barHi, rangeHi)
        float clampLo = math.max(barLo, rangeLo)
        float barSpan = clampHi - clampLo

        if barSpan <= 0
            continue

        // Find which bins this bar touches
        int binStart = math.max(0,        math.floor((clampLo - rangeLo) / binSize))
        int binEnd   = math.min(bins - 1, math.floor((clampHi - rangeLo) / binSize))

        int numBins = binEnd - binStart + 1

        for b = binStart to binEnd
            float binLo  = rangeLo + b * binSize
            float binHi  = binLo + binSize
            float overlap = math.min(clampHi, binHi) - math.max(clampLo, binLo)
            float portion = barSpan > 0 ? overlap / barSpan : 1.0 / numBins
            float cur     = array.get(binVol, b)
            array.set(binVol, b, cur + barVol * portion)

    // Find POC — bin with highest volume
    float pocVol    = 0.0
    int   pocBin    = 0
    for b = 0 to bins - 1
        float v = array.get(binVol, b)
        if v > pocVol
            pocVol := v
            pocBin := b

    float pocPrice = rangeLo + (pocBin + 0.5) * binSize

    // Value Area — expand from POC until vaPercent of total volume is covered
    float totalVol = 0.0
    for b = 0 to bins - 1
        totalVol += array.get(binVol, b)

    float vaTarget  = totalVol * (vaPercent / 100.0)
    float vaVol     = array.get(binVol, pocBin)
    int   vaLow     = pocBin
    int   vaHigh    = pocBin

    while vaVol < vaTarget
        float nextHi = vaHigh < bins - 1 ? array.get(binVol, vaHigh + 1) : 0.0
        float nextLo = vaLow  > 0        ? array.get(binVol, vaLow  - 1) : 0.0

        if nextHi >= nextLo and vaHigh < bins - 1
            vaHigh += 1
            vaVol  += nextHi
        else if vaLow > 0
            vaLow -= 1
            vaVol += nextLo
        else
            break

    float vahPrice = rangeLo + (vaHigh + 1) * binSize
    float valPrice = rangeLo + vaLow * binSize

    [pocPrice, vahPrice, valPrice]


// ─────────────────────────────────────────────────────────────────────────────
//  VOLUME AT SINGLE LEVEL
// ─────────────────────────────────────────────────────────────────────────────

f_volAtLevel(float lvlPrice, float bandHalf) =>
    float total = 0.0
    for i = 0 to i_volLookback - 1
        if high[i] >= (lvlPrice - bandHalf) and low[i] <= (lvlPrice + bandHalf)
            total += volume[i]
    total


// ─────────────────────────────────────────────────────────────────────────────
//  FIB DRAWING  +  CONFLUENCE DETECTION
// ─────────────────────────────────────────────────────────────────────────────

var float[] ratios   = array.from(0.0, 0.236, 0.382, 0.5, 0.618, 0.705, 0.786, 1.0, 1.272, 1.618)
var string[] lblTxt  = array.from("0", "0.236", "0.382", "0.5", "0.618", "0.705", "0.786", "1", "1.272", "1.618")

var line[]  fibLines  = array.new_line()
var label[] fibLabels = array.new_label()

// POC / VA lines — persistent, deleted and redrawn each update
var line  pocLine  = na
var line  vahLine  = na
var line  valLine  = na
var label pocLabel = na
var label vahLabel = na
var label valLabel = na

bool canDraw   = not na(lastSwingHighPrice) and not na(lastSwingLowPrice)
bool isBullish = canDraw and lastSwingLowBar > lastSwingHighBar

float fibTop    = isBullish ? lastSwingHighPrice : lastSwingLowPrice
float fibBottom = isBullish ? lastSwingLowPrice  : lastSwingHighPrice
float fibRange  = math.abs(fibTop - fibBottom)

int startBar = isBullish ? lastSwingLowBar : lastSwingHighBar
int endBar   = bar_index + 20

if canDraw and barstate.islast

    // ── Delete previous drawings ──────────────────────────────────────────
    for ln in fibLines
        line.delete(ln)
    for lb in fibLabels
        label.delete(lb)
    array.clear(fibLines)
    array.clear(fibLabels)
    line.delete(pocLine)
    line.delete(vahLine)
    line.delete(valLine)
    label.delete(pocLabel)
    label.delete(vahLabel)
    label.delete(valLabel)

    // ── Build internal volume profile ─────────────────────────────────────
    [pocPrice, vahPrice, valPrice] = f_buildProfile(
         math.max(fibTop, fibBottom),
         math.min(fibTop, fibBottom),
         fibRange,
         i_profBins,
         i_vaPercent,
         i_volLookback)

    float confluenceTol = fibRange * (i_confluencePct / 100.0)

    // ── Draw POC / VAH / VAL lines ────────────────────────────────────────
    if i_showPOCLine
        pocLine := line.new(startBar, pocPrice, endBar, pocPrice,
             color=i_c_poc, width=2, style=line.style_solid,
             extend = i_extendLines ? extend.right : extend.none)

    if i_showVALines
        vahLine := line.new(startBar, vahPrice, endBar, vahPrice,
             color=i_c_va, width=1, style=line.style_dotted,
             extend = i_extendLines ? extend.right : extend.none)
        valLine := line.new(startBar, valPrice, endBar, valPrice,
             color=i_c_va, width=1, style=line.style_dotted,
             extend = i_extendLines ? extend.right : extend.none)

    if i_showPOCLabel
        pocLabel := label.new(endBar, pocPrice,
             text="POC  " + str.tostring(math.round(pocPrice, 2)),
             color=color.new(color.black, 100), textcolor=i_c_poc,
             style=label.style_label_left, size=f_labelSize())
        vahLabel := label.new(endBar, vahPrice,
             text="VAH  " + str.tostring(math.round(vahPrice, 2)),
             color=color.new(color.black, 100), textcolor=i_c_va,
             style=label.style_label_left, size=f_labelSize())
        valLabel := label.new(endBar, valPrice,
             text="VAL  " + str.tostring(math.round(valPrice, 2)),
             color=color.new(color.black, 100), textcolor=i_c_va,
             style=label.style_label_left, size=f_labelSize())

    // ── Pass 1: volume per fib level ──────────────────────────────────────
    float bandHalf = fibRange * (i_volBandPct / 100.0) / 2.0
    var float[] volValues = array.new_float()
    array.clear(volValues)

    for i = 0 to array.size(ratios) - 1
        if f_showLevel(i)
            float lvlPrice = fibTop - array.get(ratios, i) * fibRange
            array.push(volValues, i_showVol ? f_volAtLevel(lvlPrice, bandHalf) : 0.0)
        else
            array.push(volValues, 0.0)

    // Rank thresholds
    var float[] sortedVols = array.copy(volValues)
    array.sort(sortedVols, order.ascending)
    int   vSize      = array.size(sortedVols)
    float vHiThresh  = vSize > 0 ? array.get(sortedVols, math.min(vSize - 1, math.round(vSize * 0.66))) : 0.0
    float vLoThresh  = vSize > 0 ? array.get(sortedVols, math.min(vSize - 1, math.round(vSize * 0.33))) : 0.0

    // ── Pass 2: draw fib lines and labels ─────────────────────────────────
    for i = 0 to array.size(ratios) - 1
        if f_showLevel(i)
            float ratio    = array.get(ratios, i)
            float lvlPrice = fibTop - ratio * fibRange
            color lvlColor = f_levelColor(i)
            float volVal   = array.get(volValues, i)

            // Confluence check
            bool hitPOC = math.abs(lvlPrice - pocPrice) <= confluenceTol
            bool hitVAH = math.abs(lvlPrice - vahPrice) <= confluenceTol
            bool hitVAL = math.abs(lvlPrice - valPrice) <= confluenceTol
            bool hasConfl = hitPOC or hitVAH or hitVAL

            string conflStr = ""
            if hasConfl
                if hitPOC
                    conflStr += " ** POC"
                if hitVAH
                    conflStr += " ** VAH"
                if hitVAL
                    conflStr += " ** VAL"

            // Volume strength label
            string volStr = ""
            if i_showVol
                string strength = ""
                if i_volStrength
                    strength := volVal >= vHiThresh ? "  HIGH" :
                                 volVal <= vLoThresh ? "  LOW"  : "  MED"
                volStr := "   Vol:" + f_fmtVol(volVal) + strength

            string priceStr  = i_showPrice ? "  " + str.tostring(math.round(lvlPrice, 2)) : ""
            string fullLabel = array.get(lblTxt, i) + priceStr + volStr + conflStr

            // Use gold color for confluence levels, normal color otherwise
            color drawColor = hasConfl ? i_c_confluence : lvlColor
            int   drawWidth = hasConfl ? math.min(i_lineWidth + 1, 4) : i_lineWidth

            ln = line.new(
                 x1     = startBar,
                 y1     = lvlPrice,
                 x2     = endBar,
                 y2     = lvlPrice,
                 color  = drawColor,
                 width  = drawWidth,
                 style  = f_lineStyle(),
                 extend = i_extendLines ? extend.right : extend.none)
            array.push(fibLines, ln)

            lb = label.new(
                 x         = endBar,
                 y         = lvlPrice,
                 text      = fullLabel,
                 color     = color.new(color.black, 100),
                 textcolor = drawColor,
                 style     = label.style_label_left,
                 size      = f_labelSize())
            array.push(fibLabels, lb)


// ─────────────────────────────────────────────────────────────────────────────
//  SWING MARKERS
// ─────────────────────────────────────────────────────────────────────────────

plotshape(not na(swingHigh), "Swing High", shape.triangledown, location.abovebar, color.new(#F7525F, 30), size = size.tiny)
plotshape(not na(swingLow),  "Swing Low",  shape.triangleup,   location.belowbar, color.new(#4CAF50, 30), size = size.tiny)


// ─────────────────────────────────────────────────────────────────────────────
//  ALERTS
// ─────────────────────────────────────────────────────────────────────────────

alertcondition(not na(swingHigh), "New Swing High", "Auto Fib Pro: Swing high updated")
alertcondition(not na(swingLow),  "New Swing Low",  "Auto Fib Pro: Swing low updated")

// end
