//@version=5
indicator("TopsAndBottoms", overlay=true, max_labels_count=500, max_lines_count=500)

leftBars    = input.int  (5,    "Left Bars",            minval=1,   maxval=50,  group="⚙️ Pivot Settings")
rightBars   = input.int  (5,    "Right Bars",           minval=1,   maxval=50,  group="⚙️ Pivot Settings")
showLabels  = input.bool (true, "Show Price Labels",                            group="🎨 Display")
showZigzag  = input.bool (true, "Show Zigzag Lines",                            group="🎨 Display")
showBG      = input.bool (true, "Flash Background",                             group="🎨 Display")
topColor    = input.color(#FF3B3B, "Top Color",                                 group="🎨 Display")
bottomColor = input.color(#00E676, "Bottom Color",                              group="🎨 Display")
useRSI      = input.bool (true,  "RSI Overbought/Oversold Filter",              group="🔬 Filters")
rsiLen      = input.int  (14,    "RSI Length",          minval=2,   maxval=50,  group="🔬 Filters")
rsiOBLevel  = input.int  (66,    "RSI Overbought Min",  minval=50,  maxval=80,  group="🔬 Filters")
rsiOSLevel  = input.int  (32,    "RSI Oversold Max",    minval=20,  maxval=50,  group="🔬 Filters")
useVol      = input.bool (false, "Volume Spike Confirmation",                   group="🔬 Filters")
volLen      = input.int  (20,    "Volume MA Length",    minval=5,   maxval=100, group="🔬 Filters")
volMult     = input.float(1.3,   "Volume Multiplier",   minval=1.0, maxval=5.0, step=0.1, group="🔬 Filters")

pivHigh = ta.pivothigh(high, leftBars, rightBars)
pivLow  = ta.pivotlow (low,  leftBars, rightBars)

rsi         = ta.rsi(close, rsiLen)
rsiAtPivot  = rsi[rightBars]
rsiTopOK    = not useRSI or (rsiAtPivot >= rsiOBLevel)
rsiBottomOK = not useRSI or (rsiAtPivot <= rsiOSLevel)

avgVol   = ta.sma(volume, volLen)
volOK    = not useVol or (volume[rightBars] >= avgVol[rightBars] * volMult)

isTop    = pivHigh and rsiTopOK    and volOK
isBottom = pivLow  and rsiBottomOK and volOK

var float zigPrice = na
var int   zigBar   = na

if showZigzag
    if isTop
        if not na(zigBar)
            line.new(zigBar, zigPrice, bar_index - rightBars, pivHigh, color=color.new(color.gray, 50), width=1)
        zigPrice := pivHigh
        zigBar   := bar_index - rightBars
    else if isBottom
        if not na(zigBar)
            line.new(zigBar, zigPrice, bar_index - rightBars, pivLow, color=color.new(color.gray, 50), width=1)
        zigPrice := pivLow
        zigBar   := bar_index - rightBars

if showLabels
    if isTop
        label.new(bar_index - rightBars, pivHigh, text="TOP\n" + str.tostring(pivHigh, format.mintick), style=label.style_label_down, color=topColor, textcolor=color.white, size=size.small)
    if isBottom
        label.new(bar_index - rightBars, pivLow, text="BOT\n" + str.tostring(pivLow, format.mintick), style=label.style_label_up, color=bottomColor, textcolor=color.white, size=size.small)

bgcolor(showBG and isTop    ? color.new(topColor,    90) : na)
bgcolor(showBG and isBottom ? color.new(bottomColor, 90) : na)

lwt = isTop ? 5 : 2
lwb = isBottom ? 5 : 2

plot(pivHigh, "Pivot High", color=isTop    ? topColor    : color.new(topColor,    80), style=plot.style_circles, offset=-rightBars)
plot(pivLow,  "Pivot Low",  color=isBottom ? bottomColor : color.new(bottomColor, 80), style=plot.style_circles, offset=-rightBars)

alertcondition(isTop,             "🔴 Precision Top",    "Top confirmed")
alertcondition(isBottom,          "🟢 Precision Bottom", "Bottom confirmed")
alertcondition(isTop or isBottom, "⚡ Pivot Detected",   "Pivot detected")